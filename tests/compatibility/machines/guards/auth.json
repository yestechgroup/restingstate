{
  "machine_name": "auth",
  "machine_ir": {
    "id": "auth",
    "initial": "loggedOut",
    "context": {
      "fields": [
        {
          "name": "isAdmin",
          "type_name": "bool",
          "default_value": false
        }
      ]
    },
    "states": [
      {
        "name": "loggedOut",
        "type": "atomic",
        "transitions": [
          {
            "event": "LOGIN",
            "guard": {
              "name": "isAdmin"
            },
            "target": "admin"
          },
          {
            "event": "LOGIN",
            "target": "basic"
          }
        ]
      },
      {
        "name": "loggedIn",
        "type": "compound",
        "initial": "basic",
        "children": [
          {
            "name": "basic",
            "type": "atomic",
            "transitions": [
              {
                "event": "LOGOUT",
                "target": "loggedOut"
              }
            ]
          },
          {
            "name": "admin",
            "type": "atomic",
            "transitions": [
              {
                "event": "LOGOUT",
                "target": "loggedOut"
              }
            ]
          }
        ]
      }
    ]
  },
  "machine_config": {
    "id": "auth",
    "initial": "loggedOut",
    "context": {
      "isAdmin": false
    },
    "states": {
      "loggedOut": {
        "on": {
          "LOGIN": [
            {
              "target": "#auth.loggedIn.admin",
              "guard": "isAdmin"
            },
            {
              "target": "#auth.loggedIn.basic"
            }
          ]
        }
      },
      "loggedIn": {
        "initial": "basic",
        "states": {
          "basic": {
            "on": {
              "LOGOUT": "#auth.loggedOut"
            }
          },
          "admin": {
            "on": {
              "LOGOUT": "#auth.loggedOut"
            }
          }
        }
      }
    }
  },
  "protocol": {
    "initial": {
      "value": "loggedOut",
      "context": {
        "isAdmin": false
      }
    },
    "events": [
      {
        "type": "LOGIN"
      }
    ]
  },
  "expected": [
    {
      "step": 0,
      "event": {
        "type": "LOGIN"
      },
      "snapshot": {
        "value": {
          "loggedIn": "basic"
        },
        "context": {
          "isAdmin": false
        }
      }
    }
  ]
}